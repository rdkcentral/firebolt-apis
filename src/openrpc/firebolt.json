{
    "openrpc": "1.2.4",
    "info": {
        "title": "Firebolt",
        "description": "Methods for querying the Firebolt platform itself",
        "version": "0.0.0"
    },
    "methods": [
        {
            "name": "version",
            "summary": "Get the current Firebolt API version",
            "params": [],
            "tags": [
                {
                    "name": "property:immutable"
                },
                {
                    "name": "capabilities",
                    "x-uses": [
                        "xrn:firebolt:capability:device:info"
                    ]
                }
            ],
            "result": {
                "name": "version",
                "summary": "The Firebolt API version",
                "schema": {
                    "$ref": "#/components/schemas/FireboltVersion"
                }
            },
            "examples": [
                {
                    "name": "Getting the Firebolt version",
                    "params": [],
                    "result": {
                        "name": "Default Result",
                        "value": {
                            "major": 1,
                            "minor": 7,
                            "patch": 0,
                            "readable": "Firebolt API v1.7.0"
                        }
                    }
                }
            ]
        },
        {
            "name": "serverVersion",
            "summary": "Get the version of the Firebolt server (gateway) running on this platform",
            "params": [],
            "tags": [
                {
                    "name": "property:immutable"
                },
                {
                    "name": "capabilities",
                    "x-uses": [
                        "xrn:firebolt:capability:device:info"
                    ]
                }
            ],
            "result": {
                "name": "version",
                "summary": "The Firebolt server version",
                "schema": {
                    "$ref": "#/components/schemas/FireboltServerVersion"
                }
            },
            "examples": [
                {
                    "name": "Getting the Firebolt server version",
                    "params": [],
                    "result": {
                        "name": "Default Result",
                        "value": {
                            "major": 2,
                            "minor": 3,
                            "patch": 1,
                            "readable": "Firebolt Server v2.3.1"
                        }
                    }
                }
            ]
        }
    ],
    "components": {
        "schemas": {
            "FireboltVersion": {
                "title": "FireboltVersion",
                "type": "object",
                "description": "The Firebolt API semantic version",
                "properties": {
                    "major": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "Major version"
                    },
                    "minor": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "Minor version"
                    },
                    "patch": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "Patch version"
                    },
                    "readable": {
                        "type": "string",
                        "description": "Human-readable version string, e.g. \"Firebolt API v1.7.0\""
                    }
                },
                "required": ["major", "minor", "patch", "readable"]
            },
            "FireboltServerVersion": {
                "title": "FireboltServerVersion",
                "type": "object",
                "description": "The Firebolt server (gateway) semantic version",
                "properties": {
                    "major": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "Major version"
                    },
                    "minor": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "Minor version"
                    },
                    "patch": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "Patch version"
                    },
                    "readable": {
                        "type": "string",
                        "description": "Human-readable version string, e.g. \"Firebolt Server v2.3.1\""
                    }
                },
                "required": ["major", "minor", "patch", "readable"]
            }
        }
    }
}
